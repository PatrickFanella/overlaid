{
  "name": "over-laid-web",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -p tsconfig.json && vite build",
    "e2e:smoke": "playwright test --config playwright.config.ts",
    "lint": "eslint .",
