# Copy to .env for local development in derived projects.
# Never commit .env.

PROJECT_NAME=overlaid

# Local Postgres used by docker-compose.yml.
POSTGRES_DB=overlaid
POSTGRES_USER=overlaid
POSTGRES_PASSWORD=change-me
# Separate non-owner app role. Use a URL-safe password; never reuse the admin password.
OVERLAID_DATABASE_PASSWORD=change-me-runtime
POSTGRES_PORT=55432
# Default for the normal Compose bridge network. If you enable API host networking
# for local OBS access, set DATABASE_URL in .env to localhost:${POSTGRES_PORT} instead.
DATABASE_URL=postgres://overlaid_app:change-me-runtime@postgres:5432/overlaid?sslmode=disable

# API and Vite defaults for the overlay MVP.
API_PORT=8080
API_ADDR=:8080
CORS_ALLOWED_ORIGIN=*
# local, lan, or public. Non-local modes degrade readiness when mutation secrets are empty.
EXPOSURE_MODE=local
DEPLOYMENT_MODE=selfhost
PRODUCT_NAME=overlaid
SUPPORT_CONTACT=
# Required in hosted mode and before connecting Twitch in selfhost mode.
# Generate a 32-byte key with: openssl rand -base64 32
VAULT_ACTIVE_KEY=
VAULT_KEYS=
OPERATOR_SECRET=
# Separate read-only overlay credential; copied source URLs include ?key=.
OVERLAY_TOKEN=
WEBHOOK_SECRET=
OVERLAY_STATE_FILE=/data/overlay-state.json
EVENT_HISTORY_FILE=/data/event-history.jsonl
EVENT_HISTORY_LIMIT=250

WEB_PORT=5173
PUBLIC_WEB_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080

# Future OBS WebSocket integration placeholder.
# Docker uses host.docker.internal to reach OBS running on the host desktop.
OBS_WEBSOCKET_URL=ws://host.docker.internal:4455
OBS_WEBSOCKET_PASSWORD=

# Twitch OAuth + EventSub integration.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_CHANNEL=patrick__eff
TWITCH_REDIRECT_URL=http://localhost:8080/api/auth/twitch/callback
TWITCH_TOKEN_FILE=/data/twitch-token.json
TWITCH_INTERACTIONS_FILE=/data/twitch-interactions.json
TWITCH_EVENTSUB_ENABLED=true
TWITCH_CHAT_DISPATCH_MODE=legacy
# Retained mode requires an isolated non-owner login inheriting overlaid_worker.
PLATFORM_WORKER_DATABASE_URL=
# Durable chat sending requires retained ingestion and separate restricted roles.
TWITCH_CHAT_SEND_MODE=legacy
PLATFORM_OUTBOUND_WORKER_DATABASE_URL=
OVERLAID_PACING_DATABASE_URL=
# Optional published shared-bot custody; never supply administrator credentials.
OVERLAID_BOT_EXECUTION_DATABASE_URL=
TWITCH_SCOPES="user:read:chat user:write:chat channel:read:redemptions channel:manage:redemptions channel:read:subscriptions bits:read moderator:read:followers moderator:manage:chat_messages moderator:manage:banned_users"

# Optional Linux MPRIS now-playing integration. Requires session bus access.
MPRIS_ENABLED=false
MPRIS_PLAYER=
MPRIS_PLAYER_PRIORITY=Feishin,mpv,cliamp,ferrosonic,playerctld,vivaldi
MPRIS_POLL_INTERVAL=2s

# Newsroom file fallback when DATABASE_URL is unset.
NEWSROOM_FILE=/data/newsroom.json

# Optional Newsroom providers (self-host only; hosted workspaces save encrypted keys).
ANTHROPIC_API_KEY=
YOUTUBE_API_KEY=
BRAVE_SEARCH_API_KEY=
NEWSROOM_DISCORD_WEBHOOK=
NEWSROOM_AI_MODEL=claude-haiku-4-5-20251001

# Shared bot command registry for self-host mode without PostgreSQL.
BOT_COMMANDS_FILE=/data/bot-commands.json
